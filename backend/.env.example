# Copy this file to backend/.env and replace every development credential.
DJANGO_SECRET_KEY=replace-with-a-long-random-development-key
DJANGO_DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DATABASE_URL=postgresql://securelearn:replace-me@127.0.0.1:5432/securelearn
DB_CONN_MAX_AGE=60
LESSON_PUBLISHED_CACHE_SECONDS=900
LESSON_REQUIRED_LOCALES=fa,en
